# ─── SUPABASE ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── SITE ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://chat.videodownloaders.cloud

# ─── SIGNALING ───────────────────────────────────────────────
NEXT_PUBLIC_SIGNALING_URL=https://chat.videodownloaders.cloud/signal

# ─── TURN SERVER ─────────────────────────────────────────────
NEXT_PUBLIC_TURN_URL=turn:chat.videodownloaders.cloud:3478
NEXT_PUBLIC_TURN_USERNAME=milobolo
NEXT_PUBLIC_TURN_CREDENTIAL=change_this_turn_secret

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change_this_redis_password

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_min_32_chars

# ─── SMTP (Hostinger) ────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=MiloBolo
SMTP_FROM_EMAIL=your-email@yourdomain.com

# ─── GOOGLE ──────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ─── WHATSAPP ────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# ─── CLOUDFLARE R2 ───────────────────────────────────────────
R2_ACCOUNT_ID=your-cf-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=milobolo-assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.videodownloaders.cloud

# ─── ADMIN ───────────────────────────────────────────────────
ADMIN_SECRET=change_this_admin_secret
